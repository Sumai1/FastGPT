# 复制为仅运维可读的 .env.production，禁止提交真实值。
CUSTOMER_SERVICE_DOMAIN=https://support.example.com
CUSTOMER_SERVICE_IMAGE=registry.example.com/company/fastgpt-customer-service:2026.08.11
# 浏览器调用方来源并集；还需在每个客服 Key 绑定中设置更窄的 allowedOrigins。
ALLOWED_ORIGINS=https://support.example.com,https://shop.example.com

FASTGPT_ROOT_KEY=replace-with-at-least-32-random-characters
FASTGPT_ROOT_PASSWORD=replace-with-strong-password
FASTGPT_FILE_TOKEN_KEY=replace-with-random-file-token-key
FASTGPT_AES256_SECRET_KEY=replace-with-32-byte-secret
FASTGPT_INVOKE_TOKEN_SECRET=replace-with-at-least-32-random-characters

MONGODB_URI=mongodb://customer_service:replace@fastgpt-mongo:27017/fastgpt?authSource=admin
REDIS_URL=redis://default:replace@fastgpt-redis:6379
PG_URL=postgresql://customer_service:replace@fastgpt-vector:5432/fastgpt
MONGO_ROOT_USER=customer_service
MONGO_ROOT_PASSWORD=replace-mongodb-password
REDIS_PASSWORD=replace-redis-password
VECTOR_PG_USER=customer_service
VECTOR_PG_PASSWORD=replace-vector-password
VECTOR_PG_DATABASE=fastgpt
AIPROXY_PG_USER=aiproxy
AIPROXY_PG_PASSWORD=replace-aiproxy-database-password
AIPROXY_PG_DATABASE=aiproxy

STORAGE_ACCESS_KEY_ID=replace-minio-access-key
STORAGE_SECRET_ACCESS_KEY=replace-minio-secret-key
AIPROXY_API_TOKEN=replace-aiproxy-admin-token

# 可选：OpenTelemetry、容量和费用告警接收端。
LOG_OTEL_URL=http://otel-collector:4318/v1/logs
