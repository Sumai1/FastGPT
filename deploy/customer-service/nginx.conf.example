# ==============================================================================
# Dual-Domain Nginx Gateway Configuration for Intelligent Customer Service
# Domain 1 (Client): support.pkiln.com  -> Proxies client container (port 3002) & public API (port 3001)
# Domain 2 (Admin) : admin.pkiln.com    -> Proxies FastGPT core backend (port 3001) with root redirect
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client Domain: support.pkiln.com (End-user Chat & Widget)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name support.pkiln.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name support.pkiln.com;

    ssl_certificate /etc/letsencrypt/live/support.pkiln.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/support.pkiln.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;

    client_max_body_size 50m;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # 1.1 Public Customer Service API -> FastGPT Core Backend (Port 3001)
    location ^~ /api/customer-service/public/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_cache off;
    }

    # 1.2 Public S3 / MinIO Assets
    location ^~ /fastgpt-public/ {
        proxy_pass http://127.0.0.1:9000/fastgpt-public/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 1.3 Hard Security Interception: Block all admin/console/dashboard routes
    location ~* ^/(dashboard|console|admin|customer-service/console|customer-service/admin|api/admin|api/customer-service/admin) {
        return 404;
    }

    # 1.4 Lightweight Client Static Hosting & SPA Routing -> Client Container (Port 3002)
    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ------------------------------------------------------------------------------
# 2. Admin Domain: admin.pkiln.com (Customer Service Operations & Console)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name admin.pkiln.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name admin.pkiln.com;

    ssl_certificate /etc/letsencrypt/live/admin.pkiln.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.pkiln.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;

    client_max_body_size 100m;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # 2.1 Root Path Redirect to Customer Service Console
    location = / {
        return 302 /customer-service/console;
    }

    # 2.2 S3 / MinIO Storage Proxies
    location ^~ /fastgpt-public/ {
        proxy_pass http://127.0.0.1:9000/fastgpt-public/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /fastgpt-private/ {
        proxy_pass http://127.0.0.1:9000/fastgpt-private/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 2.3 FastGPT Core Application Backend -> FastGPT App Container (Port 3001)
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
    }
}
